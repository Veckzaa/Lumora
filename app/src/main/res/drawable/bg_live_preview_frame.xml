<?xml version="1.0" encoding="utf-8"?>
<!-- The preview opens its channel fullscreen when clicked, so it needs a focused look for the
     D-pad. Stroke only, never a fill: the video sits inside this frame. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="3dp" android:color="@color/focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/color_border" />
        </shape>
    </item>
</selector>
