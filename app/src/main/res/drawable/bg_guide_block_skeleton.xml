<?xml version="1.0" encoding="utf-8"?>
<!-- A guide block whose programme is still loading: the normal block (focus state included,
     the layer list passes it through) with a bar where the title will be. Static on purpose:
     an animated shimmer would redraw every loading row each frame on a Fire TV stick. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_guide_block" />
    <item
        android:gravity="center_vertical|fill_horizontal"
        android:height="10dp"
        android:left="10dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
